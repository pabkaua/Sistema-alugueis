<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loja.controllers.LoginController">
   <children>
      <VBox layoutX="250.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="0.0">
         <children>
            <Region maxHeight="1.7976931348623157E308" prefHeight="250.0" prefWidth="200.0" VBox.vgrow="NEVER" />
            <VBox maxHeight="1.7976931348623157E308" prefWidth="1420.0" spacing="50.0" styleClass="login-panel" stylesheets="@../css/login.css" VBox.vgrow="ALWAYS">
               <children>
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="login-title" stylesheets="@../css/login.css" text="Bem-vindo!" textAlignment="CENTER" textFill="#fffbfb">
                     <font>
                        <Font name="Arial Bold" size="40.0" />
                     </font>
                  </Label>
                  <VBox spacing="20.0">
                     <children>
                        <Label maxWidth="1.7976931348623157E308" styleClass="login-label" stylesheets="@../css/login.css" text="Login">
                           <font>
                              <Font name="Arial" size="64.0" />
                           </font>
                        </Label>
                        <TextField fx:id="inputLogin" prefHeight="24.0" styleClass="login-input" stylesheets="@../css/login.css">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  <VBox spacing="20.0">
                     <children>
                        <Label maxWidth="1.7976931348623157E308" styleClass="login-label" stylesheets="@../css/login.css" text="Senha" />
                        <TextField fx:id="inputSenha" styleClass="login-input">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  <Button fx:id="botaoEntrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#validarDados" prefHeight="100.0" prefWidth="1300.0" styleClass="login-button" stylesheets="@../css/login.css" text="Entrar" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="45.0" left="60.0" right="60.0" top="45.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
