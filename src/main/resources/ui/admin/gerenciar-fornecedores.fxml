<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefHeight="1080.0" prefWidth="1500.0" spacing="20.0" style="-fx-background-color: #0e0d12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loja.controllers.admin.GerenciarFornecedoresController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label minWidth="-Infinity" text="Fornecedores" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="botaoNovoForne" minWidth="-Infinity" mnemonicParsing="false" onAction="#novoFornecedor" prefHeight="44.0" prefWidth="160.0" style="-fx-background-color: #3b0764; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="+ Novo" textFill="WHITE" />
            </children>
        </HBox>


        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <ComboBox fx:id="listaColuna" minWidth="120.0" prefHeight="44.0" prefWidth="180.0" promptText="COLUNA" />
                <TextField fx:id="campoBusca" maxWidth="1.7976931348623157E308" minWidth="100.0" prefHeight="44.0" promptText="Digite o valor que deseja buscar na coluna especificada..." HBox.hgrow="ALWAYS" />
                <Button fx:id="botaoBuscar" minWidth="-Infinity" mnemonicParsing="false" onAction="#buscar" prefHeight="44.0" prefWidth="120.0" style="-fx-background-color: #3b0764; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Buscar" textFill="WHITE" />
            </children>
        </HBox>


        <HBox alignment="CENTER_RIGHT" minHeight="44.0" spacing="10.0">
            <children>
                <Button fx:id="botaoEditar" minWidth="-Infinity" mnemonicParsing="false" onAction="#editar" opacity="0.88" prefHeight="44.0" prefWidth="120.0" style="-fx-background-color: #ffffff; -fx-border-color: #3b0764; -fx-border-radius: 8; -fx-border-width: 1; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Editar" textFill="#3b0764" visible="false" />
                <Button fx:id="botaoExcluir" minWidth="-Infinity" mnemonicParsing="false" onAction="#excluir" opacity="0.73" prefHeight="44.0" prefWidth="120.0" style="-fx-background-color: red; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Excluir" textFill="WHITE" visible="false" />
            </children>
        </HBox>


        <TableView fx:id="tabela" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="150.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colunaSelecionar" maxWidth="140.0" minWidth="80.0" prefWidth="107.0" text="Selecionar" />
                <TableColumn fx:id="colunaID" minWidth="60.0" prefWidth="182.0" text="ID" />
                <TableColumn fx:id="colunaNome" minWidth="150.0" prefWidth="400.0" text="Nome" />
                <TableColumn fx:id="colunaCNPJ" minWidth="140.0" prefWidth="250.0" text="CNPJ" />
                <TableColumn fx:id="colunaTelefone" minWidth="120.0" prefWidth="250.0" text="Telefone" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <stylesheets>
        <URL value="@../../css/telas.css" />
    </stylesheets>
</VBox>
