<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../../css/sidebar-cliente.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.loja.controllers.SidebarAdminController">
   <left>
      <VBox fx:id="sidebarVbox" minWidth="420.0" prefWidth="420.0" spacing="20.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
         <children>
            <Label fx:id="tituloLoja" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="titulo-loja" text="Aluga Tudo">
               <font>
                  <Font size="40.0" />
               </font>
               <textFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
            <Button fx:id="botaoDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#navegarDashboard" styleClass="btn-principal" text="📊   Dashboard" />
            <VBox spacing="4.0">
               <children>
                  <Button fx:id="btnAdminGerenciarUsuarios" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-principal" text="⌄   Gerenciar Usuários" />
                  <VBox fx:id="submenuAdminGerenciarUsuarios" spacing="4.0" styleClass="submenu-card" visible="false">
                     <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                     </padding>
                     <children>
                        <Button fx:id="btnAdminCadastrarUsuario" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Cadastrar Usuário" />
                        <Button fx:id="btnAdminListarUsuarios" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Listar Usuários" />
                        <Button fx:id="btnAdminAtualizarUsuario" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="54.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Atualizar Usuário" />
                        <Button fx:id="btnAdminDesativarUsuario" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="92.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Desativar Usuário" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Button fx:id="btnAdminGerenciarItens" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-principal" text="⌄   Gerenciar Itens" />
                  <VBox fx:id="submenuAdminGerenciarItens" spacing="4.0" styleClass="submenu-card" visible="false">
                     <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
                     </padding>
                     <children>
                        <Button fx:id="btnAdminCadastrarItem" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Cadastrar Item" />
                        <Button fx:id="btnAdminListarItens" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="16.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Listar Itens" />
                        <Button fx:id="btnAdminAtualizarItem" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="54.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-subitem" text="○   Atualizar Item" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Region maxHeight="1.7976931348623157E308" minHeight="0.0" prefWidth="0.0" VBox.vgrow="ALWAYS" />
            <Button fx:id="botaoLogout" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#fazerLogout" styleClass="btn-logout" text="↪   Logout" />
         </children>
      </VBox>
   </left>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" minWidth="0.0" style="-fx-background-color: #181721; -fx-background: transparent;" BorderPane.alignment="CENTER">
         <content>
            <StackPane fx:id="conteudo" styleClass="content-area" />
         </content>
      </ScrollPane>
   </center>
</BorderPane>
